# ╔══════════════════════════════════════════════════════════════╗
# ║  Имперское Таро — конфигурация когитатора LM Studio            ║
# ╚══════════════════════════════════════════════════════════════╝
#
# Скопируй этот файл в .env и при необходимости измени значения.
# Все переменные опциональны — без них действуют каноничные умолчания.

# Базовый URL OpenAI-совместимого API LM Studio (с суффиксом /v1).
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Идентификатор модели. "auto" — взять первую загруженную в LM Studio.
LMSTUDIO_MODEL=auto

# Ключ API. LM Studio его игнорирует, но клиент требует значение.
LMSTUDIO_API_KEY=lm-studio

# Температура генерации (0.0 — строго, 1.0+ — вольно). По умолчанию 0.85.
LMSTUDIO_TEMPERATURE=0.85

# Максимум токенов ответа (-1 — без ограничения со стороны клиента).
LMSTUDIO_MAX_TOKENS=-1

# Тайм-аут запроса в миллисекундах.
LMSTUDIO_TIMEOUT_MS=120000
